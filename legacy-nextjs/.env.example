# ─────────────────────────────────────────────────────────────
# Copia este archivo a ".env" y rellena los valores reales.
# ─────────────────────────────────────────────────────────────

# Base de datos: PostgreSQL (local y producción, para paridad dev/prod).
#
#  - Producción (Vercel): usa Neon o Vercel Postgres y pega aquí su cadena.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
#
#  - Local sin instalar nada: deja esta URL y corre `npm run db:local`
#    (levanta un Postgres local efímero en 127.0.0.1:5433).
# DATABASE_URL="postgresql://postgres@127.0.0.1:5433/quiniela?schema=public"

# Secret para firmar las sesiones de Auth.js.
# Genera uno con:  openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# En despliegues (Vercel) deja que Auth.js confíe en el host.
AUTH_TRUST_HOST="true"

# Credenciales de Google OAuth (Google Cloud Console > Credentials).
# Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
# (y la equivalente en producción: https://TU-DOMINIO/api/auth/callback/google)
AUTH_GOOGLE_ID="tu-google-client-id"
AUTH_GOOGLE_SECRET="tu-google-client-secret"

# Lista de correos administradores, separados por coma.
ADMIN_EMAILS="ernesto@agency.lat"
