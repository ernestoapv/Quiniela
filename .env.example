# ─────────────────────────────────────────────────────────────
# Copia este archivo a ".env" y rellena los valores reales.
# ─────────────────────────────────────────────────────────────

# Base de datos.
#  - Local (SQLite, por defecto):
DATABASE_URL="file:./dev.db"
#  - Producción (Postgres, ej. Neon/Vercel). Cambia también el
#    provider en prisma/schema.prisma a "postgresql".
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret para firmar las sesiones de Auth.js.
# Genera uno con:  openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# En despliegues (Vercel) deja que Auth.js confíe en el host.
AUTH_TRUST_HOST="true"

# Credenciales de Google OAuth (Google Cloud Console > Credentials).
# Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
# (y la equivalente en producción: https://TU-DOMINIO/api/auth/callback/google)
AUTH_GOOGLE_ID="tu-google-client-id"
AUTH_GOOGLE_SECRET="tu-google-client-secret"

# Lista de correos administradores, separados por coma.
ADMIN_EMAILS="ernesto@agency.lat"
